# App
APP_NAME=SmartGallery
APP_VERSION=0.1.0
APP_ENVIRONMENT=production
DEBUG=true
EXPOSE_API_DOCS=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000

# Local testing only. scripts/setup-local.ps1 generates these safely.
LOCAL_DEV_AUTH=false
LOCAL_DEV_AUTH_TOKEN=
LOCAL_DEV_USER_EMAIL=developer@localhost

# Supabase — Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase — Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only
SUPABASE_JWT_AUDIENCE=authenticated
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Redis Cloud — from redis.com dashboard
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
CELERY_BROKER_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
CELERY_RESULT_BACKEND=redis://default:[PASSWORD]@[HOST]:[PORT]
AUTO_SYNC_INTERVAL_MINUTES=30
SEARCH_SESSION_RETENTION_DAYS=30

# Public search security
MAX_SELFIE_BYTES=8388608
MAX_IMAGE_PIXELS=25000000
PUBLIC_SEARCHES_PER_MINUTE=10
# Set to your platform's documented proxy hop count; keep 0 when directly exposed.
TRUSTED_PROXY_HOPS=0
PHOTO_ACCESS_TOKEN_MINUTES=15

# Face recognition
SIMILARITY_THRESHOLD=0.5
MAX_SEARCH_RESULTS=200
FACE_MODEL_NAME=buffalo_l
FACE_DETECTION_SIZE=640
FACE_DETECTION_FALLBACK_SIZE=1024

# Note: Google OAuth login is configured in Supabase Dashboard.
# The backend uses the stored Drive refresh token from the Supabase session.
